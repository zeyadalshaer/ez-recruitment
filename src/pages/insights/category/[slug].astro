---
import V from '../../../views/Category.astro';
import { getCategories } from '../../../lib/site';
export async function getStaticPaths() {
  const cats = await getCategories();
  return cats.map((c) => ({ params: { slug: c.id }, props: { cat: c } }));
}
const { cat } = Astro.props;
---
<V cat={cat} />
