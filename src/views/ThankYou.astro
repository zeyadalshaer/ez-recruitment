---
import { getLocale, localizePath } from '../lib/i18n';
import { T } from '../lib/site';
const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);
const t = T(locale);
const c = t.contact;
import Layout from '../layouts/Layout.astro';

---
<Layout title={t.ui.thankYouTitle} noindex>
  <section class="section notfound">
    <div class="container container--narrow">
      <p class="eyebrow">{t.ui.enquiryReceived}</p>
      <h1>{c.successHeading}</h1>
      <p>{c.successText}</p>
      <div class="hero__actions">
        <a class="btn btn--navy" href={L('/')}>{t.ui.backHome}</a>
        <a class="btn btn--outline" href={L('/insights/')}>{t.ui.readInsights}</a>
      </div>
    </div>
  </section>
</Layout>
