---
import { T } from '../lib/site';
import Logo from './Logo.astro';

import { getLocale, stripLocale, localizePath, localeMeta, publishedLocales } from '../lib/i18n';

const locale = getLocale(Astro.url.pathname);
const base = stripLocale(Astro.url.pathname);
const L = (href: string) => localizePath(href, locale);
const isActive = (href: string) => href !== '/' && base.startsWith(href.split('#')[0]);
const showLang = publishedLocales.length > 1;
const t = T(locale);
const nav = t.nav;
const ui = t.ui;
---
<a class="skip-link" href="#main">{ui.skip}</a>
<header class="site-header" data-header>
  <div class="container header__inner">
    <a class="brand" href={L('/')} aria-label={ui.homeAria}><Logo /></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={ui.openMenu} data-nav-toggle>
      <span></span><span></span><span></span>
    </button>
    <nav class="nav" id="site-nav" aria-label={ui.mainNav} data-nav>
      <ul class="nav__list">
        <li class="nav__home"><a href={L('/')} aria-current={base === '/' ? 'page' : undefined}>{ui.home}</a></li>
        {nav.main.map((l) => (
          <li><a href={L(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <a class="btn btn--primary btn--sm nav__cta" href={L(nav.cta.href)}>{nav.cta.label}</a>
      {showLang && (
        <details class="lang">
          <summary aria-label={ui.language}>{localeMeta[locale].native}</summary>
          <ul>
            {publishedLocales.map((l) => (
              <li><a href={localizePath(base, l)} hreflang={localeMeta[l].htmlLang} lang={localeMeta[l].htmlLang} aria-current={l === locale ? 'true' : undefined}>{localeMeta[l].native}</a></li>
            ))}
          </ul>
        </details>
      )}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const navEl = document.querySelector<HTMLElement>('[data-nav]');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    navEl?.classList.toggle('is-open', open);
    document.body.classList.toggle('nav-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  navEl?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
