---
import { getLocale, localizePath } from '../lib/i18n';
import { T } from '../lib/site';
const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);
const t = T(locale);
const pages = t.pages;
import PostCard from './PostCard.astro';
import { getCategories, getPosts } from '../lib/site';

interface Props { category?: string; showFeatured?: boolean }
const { category, showFeatured = true } = Astro.props;

const [all, cats] = await Promise.all([getPosts(locale), getCategories(locale)]);
const posts = category ? all.filter((p) => p.data.category === category) : all;
const featured = showFeatured ? (posts.find((p) => p.data.featured) ?? posts[0]) : undefined;
const rest = featured ? posts.filter((p) => p.id !== featured.id) : posts;
---
<div class="blog-tools">
  <div class="chips chips--filter" role="navigation" aria-label={t.ui.articleCategories}>
    <a href={L('/insights/')} aria-current={!category ? 'page' : undefined}>{t.ui.all} <span>{all.length}</span></a>
    {cats.map((c) => (
      <a href={L(`/insights/category/${c.id}/`)} aria-current={category === c.id ? 'page' : undefined}>{c.title} <span>{c.count}</span></a>
    ))}
  </div>
  <form class="search" role="search" onsubmit="return false">
    <label for="post-search" class="sr-only">{t.ui.searchArticles}</label>
    <input id="post-search" type="search" placeholder={t.ui.searchArticles} autocomplete="off" data-search-input />
  </form>
</div>

<p class="blog-count" role="status" aria-live="polite" data-count data-tpl={t.ui.articlesFound}></p>

{posts.length === 0 ? (
  <p class="empty">{t.ui.noArticles}</p>
) : (
  <>
    {featured && <PostCard post={featured} featured />}
    <div class="post-grid">
      {rest.map((p) => <PostCard post={p} />)}
    </div>
  </>
)}
<p class="empty" data-empty hidden>{pages.insights.emptyText}</p>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-post]'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const count = document.querySelector<HTMLElement>('[data-count]');

  function apply() {
    const terms = (input?.value ?? '').toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    cards.forEach((c) => {
      const hay = c.dataset.search ?? '';
      const match = terms.every((t) => hay.includes(t));
      c.hidden = !match;
      if (match) shown++;
    });
    if (empty) empty.hidden = shown !== 0 || cards.length === 0;
    if (count) count.textContent = terms.length ? (count.dataset.tpl ?? '').replace('{n}', String(shown)) : '';
  }

  const q = new URLSearchParams(location.search).get('q');
  if (input && q) input.value = q;
  input?.addEventListener('input', apply);
  apply();
</script>
