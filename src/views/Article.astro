---
import { getLocale, localizePath } from '../lib/i18n';
import { T } from '../lib/site';
const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);
const t = T(locale);
const site = t.site;
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import PostCard from '../components/PostCard.astro';
import ShareLinks from '../components/ShareLinks.astro';
import CtaBand from '../components/CtaBand.astro';
import { entrySlug, absUrl, categoryTitle, formatDate, getPosts, getRelated, readingTime } from '../lib/site';

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, image, imageAlt, category, author } = post.data;
const catName = await categoryTitle(category, locale);
const related = getRelated(post, await getPosts(locale));
const url = absUrl(`/insights/${entrySlug(post)}/`);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  mainEntityOfPage: url,
};
---
<Layout title={title} description={description} image={image} type="article" publishedTime={date} modifiedTime={updated ?? date} jsonLd={[articleLd]}>
  <article>
    <header class="article-head">
      <div class="container container--narrow">
        <nav class="crumbs crumbs--dark" aria-label={t.ui.breadcrumb}>
          <ol>
            <li><a href={L('/')}>{t.ui.home}</a></li>
            <li><a href={L('/insights/')}>{t.ui.insights}</a></li>
            <li><a href={L(`/insights/category/${category}/`)}>{catName}</a></li>
          </ol>
        </nav>
        <p class="article-head__meta">
          <a href={L(`/insights/category/${category}/`)} class="tag">{catName}</a>
          <span><time datetime={date.toISOString()}>{formatDate(date, locale)}</time> · {t.ui.minRead.replace('{n}', String(readingTime(post.body)))}</span>
        </p>
        <h1>{title}</h1>
        <p class="article-head__lead">{description}</p>
        <p class="article-head__by">{t.ui.by} {author}</p>
      </div>
    </header>

    {image && (
      <div class="container article-hero">
        <Img src={image} alt={imageAlt ?? ''} loading="eager" fetchpriority="high" sizes="(min-width: 1200px) 1100px, 100vw" />
      </div>
    )}

    <div class="container container--narrow article-body">
      <div class="prose"><Content /></div>
      <ShareLinks url={url} title={title} />
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section--mist">
      <div class="container">
        <h2 class="related-title">{t.ui.relatedArticles}</h2>
        <div class="post-grid">
          {related.map((p) => <PostCard post={p} />)}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</Layout>
