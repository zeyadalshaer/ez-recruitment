---
// Any page created under "Pages" is published at /<slug>/.
import V from '../views/Page.astro';
import { getLocalized, entrySlug } from '../lib/site';
export async function getStaticPaths() {
  const pages = await getLocalized('pages');
  return pages.map((page) => ({ params: { slug: entrySlug(page) }, props: { page } }));
}
const { page } = Astro.props;
---
<V page={page} />
