---
import { getLocale, localizePath } from '../lib/i18n';
import { T } from '../lib/site';
const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);
const t = T(locale);
const pages = t.pages;
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import BlogIndex from '../components/BlogIndex.astro';
import CtaBand from '../components/CtaBand.astro';


const p = pages.insights;
---
<Layout title={p.title} description={p.description}>
  <PageHero eyebrow={p.eyebrow} title={p.title} intro={p.intro} crumb={[{ label: p.title }]} />
  <section class="section section--tight">
    <div class="container">
      <BlogIndex />
    </div>
  </section>
  <CtaBand />
</Layout>
